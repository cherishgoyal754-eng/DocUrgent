# ==============================================================================
# DocUrgent 24/7 — Production Environment Variables Configuration Template
# Copy this file to .env and configure real secrets for your environment
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Server Network Configuration
PORT=8095
NODE_ENV=production
APP_BASE_URL=https://docurgent.in

# Super Admin Platform Owner Account
SUPERADMIN_EMAIL=owner@docurgent.in
SUPERADMIN_PASSWORD=SetAStrongRandomPassword2026!#
SUPERADMIN_PHONE=+919999999999

# Platform Financial Operations
PLATFORM_COMMISSION_PERCENT=15
DEFAULT_CURRENCY=INR

# Cryptographic Master Signing Key (32-byte hex string)
SERVER_SECRET_KEY=generate_with_python_secrets_token_hex_32

# Operational Monitoring & Alert Dispatching
ALERT_EMAIL=admin@docurgent.in
STORAGE_QUOTA_MB=5000
MAX_UPLOAD_SIZE_MB=5

# Managed Database Connection (Optional if migrating from SQLite to Supabase/PostgreSQL)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# Payment Gateway Sandbox / Live Credentials
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
